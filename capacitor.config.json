{
  "appId": "com.foodtruck.alarm",
  "appName": "푸드트럭 알리미",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#EF4444",
      "showSpinner": false
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_notification",
      "iconColor": "#EF4444",
      "sound": "default"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#EF4444"
    }
  }
}
